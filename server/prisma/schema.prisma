generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// Null for Google-only accounts (no local password).
  passwordHash String?
  /// Google OpenID subject; null for password-only accounts.
  googleId     String?  @unique
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String
  mobile        String
  email         String
  city          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries  Enquiry[]
  quotations Quotation[]
  salesOrders SalesOrder[]

  @@index([companyName])
  @@index([email])
}

model Product {
  id          String   @id @default(cuid())
  productCode String   @unique
  productName String
  category    String
  unit        String
  basePrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory        Inventory?
  enquiryItems     EnquiryItem[]
  quotationItems   QuotationItem[]
  salesOrderItems  SalesOrderItem[]

  @@index([category])
  @@index([productName])
}

/// One inventory row per product. Available qty is derived:
/// physicalQuantity - reservedQuantity (never stored separately).
/// Service layer must use transactions + row locks (SELECT FOR UPDATE)
/// so concurrent reservations cannot both succeed against the same stock.
model Inventory {
  id               String   @id @default(cuid())
  productId        String   @unique
  physicalQuantity Int
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// ---------------------------------------------------------------------------
// Enquiry → Quotation → Sales Order → Dispatch
// ---------------------------------------------------------------------------

model Enquiry {
  id            String        @id @default(cuid())
  enquiryNumber String        @unique
  customerId    String
  enquiryDate   DateTime
  requiredDate  DateTime
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      EnquiryItem[]
  quotations Quotation[]

  @@index([customerId])
  @@index([status])
  @@index([enquiryDate])
}

model EnquiryItem {
  id        String @id @default(cuid())
  enquiryId String
  productId String
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([enquiryId])
  @@index([productId])
  @@unique([enquiryId, productId])
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  enquiryId       String
  customerId      String
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  grandTotal      Decimal         @db.Decimal(14, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  enquiry    Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@index([enquiryId])
  @@index([customerId])
  @@index([status])
}

model QuotationItem {
  id              String  @id @default(cuid())
  quotationId     String
  productId       String
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
  gstPercent      Decimal @db.Decimal(5, 2) @default(0)
  lineAmount      Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
  @@unique([quotationId, productId])
}

/// quotationId is unique: one quotation can produce at most one sales order.
model SalesOrder {
  id          String           @id @default(cuid())
  orderNumber String           @unique
  customerId  String
  quotationId String           @unique
  orderDate   DateTime
  totalAmount Decimal          @db.Decimal(14, 2)
  status      SalesOrderStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  items     SalesOrderItem[]
  dispatch  Dispatch?

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
}

model SalesOrderItem {
  id           String  @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  lineAmount   Decimal @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([productId])
  @@unique([salesOrderId, productId])
}

/// salesOrderId is unique: one sales order can have at most one dispatch record.
/// Quantity safety vs reserved stock is enforced in the service layer with transactions.
model Dispatch {
  id             String   @id @default(cuid())
  dispatchNumber String   @unique
  salesOrderId   String   @unique
  dispatchDate   DateTime
  vehicleNumber  String
  driverName     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  @@index([dispatchDate])
}
