VITE_API_URL=http://localhost:5000

# Google Client ID is configured on the server for the OAuth redirect flow.
# The frontend only needs the API URL; "Continue with Google" opens:
#   ${VITE_API_URL}/api/auth/google
# Optional display/docs reference (not required by the current redirect implementation):
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
